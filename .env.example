# ─────────────────────────────────────────────────────────────────
# RevivePay AI — Root Environment Variables
#
# These are used by docker-compose.yml.
# Copy to .env and fill in values before running docker compose.
#
# The server reads its OWN server/.env file.
# The client reads its OWN client/.env.local file.
# ─────────────────────────────────────────────────────────────────

# URL the browser uses to reach the API.
# In docker-compose production: http://localhost/api  (nginx strips /api)
# In local dev without Docker:  http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost/api